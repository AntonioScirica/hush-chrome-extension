{
  "manifest_version": 3,
  "name": "Hush",
  "description": "Compila utente e password da Hush, senza copiare e incollare.",
  "version": "1.4",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png"
    },
    "default_popup": "popup.html",
    "default_title": "Hush"
  },
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"]
}
